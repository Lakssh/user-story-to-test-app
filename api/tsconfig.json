{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "*": ["*", "backend/src/*"]
    }
  },
  "include": ["**/*.ts", "../backend/src/**/*.ts"],
  "exclude": ["node_modules", ".vercel"]
}
